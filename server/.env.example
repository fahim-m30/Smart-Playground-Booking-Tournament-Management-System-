# Required production values. Never commit the real .env file.
DATABASE_URL=mongodb+srv://USER:PASSWORD@CLUSTER/turf
JWT_ACCESS_SECRET=generate-a-long-random-secret
QR_SIGNING_SECRET=generate-a-different-long-random-secret
JWT_ACCESS_EXPIRES=7d
CLIENT_URL=https://your-project.vercel.app
APP_TIME_ZONE=Asia/Dhaka

# Required for email verification.
BREVO_API_KEY=your-brevo-api-key
BREVO_SENDER_EMAIL=no-reply@your-domain.com
BREVO_SENDER_NAME=TURF

# Leave demo payment mode enabled until live SSLCommerz credentials are ready.
STORE_ID=your-store-id
STORE_PASSWORD=your-store-password
SSL_IS_LIVE=false
